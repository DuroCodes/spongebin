{
  "name": "spongebin-vscode",
  "displayName": "spongebin",
  "description": "Create spongebin pastes from VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "spongebin",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spongebin.upload",
        "title": "spongebin: upload"
      }
    ],
    "configuration": {
      "title": "spongebin",
      "properties": {
        "spongebin.baseUrl": {
          "type": "string",
          "default": "https://spongebin.dev",
          "description": "Base URL of your spongebin instance."
        },
        "spongebin.defaultLanguage": {
          "type": "string",
          "default": "text",
          "description": "Fallback language when the file has no recognizable extension (normally inferred from the open file)."
        },
        "spongebin.theme": {
          "type": "string",
          "default": "catppuccin-mocha",
          "description": "Theme name to send when creating a paste."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
    "watch": "bun run compile -- --watch",
    "package": "bun run compile && vsce package --allow-missing-repository",
    "publish": "bun run compile && vsce publish",
    "prepublishOnly": "bun run compile",
    "check": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@spongebin/shared": "workspace:*",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  }
}
