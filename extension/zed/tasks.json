[
  {
    "label": "spongebin: upload",
    "command": "bun",
    "args": [
      "run",
      "$ZED_WORKTREE_ROOT/extension/zed/upload.ts",
      "--file",
      "$ZED_FILE",
      "--filename",
      "$ZED_FILENAME"
    ],
    "env": {
      "ZED_SELECTED_TEXT": "${ZED_SELECTED_TEXT:}",
      "SPONGEBIN_BASE_URL": "https://spongebin.dev",
      "SPONGEBIN_THEME": "catppuccin-mocha"
    },
    "reveal": "no_focus",
    "hide": "on_success",
    "show_summary": false,
    "show_command": false
  }
]
