{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@spongebin/shared": ["../../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../shared/src/**/*.ts"]
}
